#!/bin/bash
# Bootstraps an app instance on Amazon Linux 2023. Rendered by Terraform
# (templatefile); bash variables are written without braces on purpose.
set -euo pipefail
exec > >(tee /var/log/app-bootstrap.log) 2>&1

echo "== metadata (IMDSv2)"
TOKEN=$(curl -sS -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
md() { curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/$1"; }
INSTANCE_ID=$(md instance-id)
AZ=$(md placement/availability-zone)

echo "== packages"
dnf install -y python3 python3-pip
useradd --system --home-dir /opt/app --shell /sbin/nologin app || true
mkdir -p /opt/app
python3 -m venv /opt/app/venv
/opt/app/venv/bin/pip install --quiet --upgrade pip
/opt/app/venv/bin/pip install --quiet "psycopg[binary]>=3.1,<4" "boto3>=1.34"

echo "== app"
cat > /opt/app/app.py <<'APP_PY'
${app_py}
APP_PY

cat > /etc/app.env <<ENV
APP_PORT=${app_port}
INSTANCE_ID=$INSTANCE_ID
AVAILABILITY_ZONE=$AZ
AWS_REGION=${region}
DB_HOST=${db_host}
DB_NAME=${db_name}
DB_SECRET_ARN=${db_secret_arn}
ENV
chmod 640 /etc/app.env
chown -R app:app /opt/app
chgrp app /etc/app.env

cat > /etc/systemd/system/app.service <<'UNIT'
[Unit]
Description=ha-web-app
After=network-online.target
Wants=network-online.target

[Service]
User=app
EnvironmentFile=/etc/app.env
ExecStart=/opt/app/venv/bin/python /opt/app/app.py
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now app

echo "== smoke test"
for i in $(seq 1 15); do
  if curl -fsS "http://127.0.0.1:${app_port}/health"; then echo; echo "bootstrap complete"; exit 0; fi
  sleep 2
done
echo "app did not become healthy" >&2
exit 1
